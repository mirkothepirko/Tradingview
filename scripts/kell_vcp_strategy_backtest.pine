//@version=6
// Kell + Minervini VCP Strategy — Backtest [v2]
//
// Recherche-Korrekturen gegenüber v1:
//   • EMA 10 hinzugefügt (Kells primärster MA — war bisher fehlend!)
//   • EMA 100 entfernt (von keinem der beiden Systeme genutzt)
//   • Wedge Pop: Crossover EMA20 + above EMA10 (statt EMA50-Crossover)
//   • EMA Crossback: EMA10 ODER EMA20 (Kell: "first pullback to 10 or 20 EMA")
//   • EMA-Ausrichtung: ema10 > ema20 > ema50 (statt nur ema20 > ema50)
//   • Exhaustion: 15% über EMA10 (statt 20% über EMA20)
//   • Wedge Drop: close < ema10 UND ema20 (Kells echte Regel — nicht EMA50)
//   • RSI: kein Pflichtfilter mehr (Kell nutzt RSI nicht primär)
//   • Minervini Trend Template: SMA50/150/200 (Simple MAs! nicht EMA)
//   • SMA 150 hinzugefügt (Trend Template-Pflichtbestandteil)
//   • 52-Wochen Filter: within 25% of high + >30% above low
//   • Volumen-Avg: 50 Bars (Minervini Standard statt 20)
//   • Volumen Multiplikator: 1.4 = 140% (Minervini: mindestens 140%)
//   • VCP: Volume Dry-Up Check (<65% des Avg während Kontraktion)
//   • Profit Target: 20% (Minervinis erster Take-Profit — statt ~6% aus 2R×3%-Stop)
//   • Stop: 3% unter EMA10 (Kell: "below the 10 EMA"), max 8% Hard Stop (O'Neil)
//   • Trail-Exit: Wedge Drop (EMA10+20 beide unterschritten) ODER EMA50 Unterschreitung

strategy("Kell + Minervini VCP [Backtest v2]",
  overlay=true,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=10,
  initial_capital=10000,
  commission_type=strategy.commission.percent,
  commission_value=0.1,
  slippage=2,
  max_bars_back=500)

// ══════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════
grp_ma   = "Moving Averages"
grp_vcp  = "VCP (Minervini)"
grp_flt  = "Filter"
grp_risk = "Risk Management"
grp_disp = "Anzeige"

// Kell EMAs
ema10_len  = input.int(10,  "EMA 10 (Kell Primär)",  group=grp_ma)
ema20_len  = input.int(20,  "EMA 20 (Kell Primär)",  group=grp_ma)
ema50_len  = input.int(50,  "EMA 50 (Trend/Trail)",  group=grp_ma)
ema200_len = input.int(200, "EMA 200 (Langfrist)",   group=grp_ma)

// Minervini Trend Template
use_tt = input.bool(true, "Minervini Trend Template (SMA 50/150/200)", group=grp_ma)

// VCP
vol_len   = input.int(50,    "Volumen Avg (Bars) — Minervini: 50 Tage", group=grp_vcp)
vol_mult  = input.float(1.4, "Ausbruch-Volumen Multiplikator (140%+)",   step=0.1, group=grp_vcp)
atr_ratio = input.float(0.7, "ATR Kontraktion Schwelle",                  step=0.05, group=grp_vcp)

// Filter
rsi_len     = input.int(14, "RSI Länge",             group=grp_flt)
rsi_ext_min = input.int(78, "RSI Exhaustion Schwelle", group=grp_flt)

// Risk Management
stop_pct    = input.float(3.0,  "Stop Loss % unter EMA10 (Kell: below 10 EMA)", step=0.5, group=grp_risk)
max_loss    = input.float(8.0,  "Max Verlust % — Hard Stop (O'Neil)",            step=0.5, group=grp_risk)
profit_pct  = input.float(20.0, "Profit Ziel % (Minervini: 1. Take-Profit 20%)", step=1.0, group=grp_risk)
from_year   = input.int(2022,   "Start Jahr",   group=grp_risk)
from_month  = input.int(1,      "Start Monat",  group=grp_risk)
from_day    = input.int(1,      "Start Tag",    group=grp_risk)

show_bg    = input.bool(true, "Hintergrundfarben", group=grp_disp)
show_table = input.bool(true, "Info-Tabelle",      group=grp_disp)

// ══════════════════════════════════════════════════════
// MOVING AVERAGES
// ══════════════════════════════════════════════════════
ema10  = ta.ema(close, ema10_len)
ema20  = ta.ema(close, ema20_len)
ema50  = ta.ema(close, ema50_len)
ema200 = ta.ema(close, ema200_len)

// Minervini Trend Template: SMA (Simple — nicht Exponential!)
sma50  = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)

p10  = plot(ema10,  "EMA 10",  color=color.new(#b2ff59, 0), linewidth=1)
p20  = plot(ema20,  "EMA 20",  color=color.new(#00e676, 0), linewidth=1)
p50  = plot(ema50,  "EMA 50",  color=color.new(#2196f3, 0), linewidth=2)
p200 = plot(ema200, "EMA 200", color=color.new(#f44336, 0), linewidth=2)

fill(p10, p20, color=ema10 > ema20 ? color.new(color.green, 90) : color.new(color.red, 90), title="EMA 10/20 Zone")

// ══════════════════════════════════════════════════════
// INDIKATOREN
// ══════════════════════════════════════════════════════
rsi     = ta.rsi(close, rsi_len)
atr     = ta.atr(14)
atr5    = ta.atr(5)
avg_vol = ta.sma(volume, vol_len)

// ══════════════════════════════════════════════════════
// MINERVINI TREND TEMPLATE (8 Kriterien — SMA!)
// ══════════════════════════════════════════════════════
high52w       = ta.highest(high, 252)
low52w        = ta.lowest(low, 252)
sma200_rising = sma200 > sma200[21]
within25_high = close >= high52w * 0.75
above30_low   = close >= low52w  * 1.30

tt_ma    = close > sma50 and sma50 > sma150 and sma150 > sma200
tt_trend = sma200_rising and within25_high and above30_low
trend_template = tt_ma and tt_trend

tt_ok = not use_tt or trend_template

// ══════════════════════════════════════════════════════
// KELL BASISBEDINGUNGEN
// ══════════════════════════════════════════════════════
above10  = close > ema10
above20  = close > ema20
above50  = close > ema50
above200 = close > ema200

// EMA-Ausrichtung: 10 > 20 > 50 (alle drei gestapelt)
ema_align = ema10 > ema20 and ema20 > ema50
high_vol  = volume >= avg_vol * vol_mult
bull_trend = above10 and above20 and above50 and above200 and ema_align

// ══════════════════════════════════════════════════════
// OLIVER KELL ZYKLUSPHASEN (KORRIGIERT)
// ══════════════════════════════════════════════════════

// Phase 2: WEDGE POP — Crossover EMA20 + über EMA10 + Volumen
wedge_pop = ta.crossover(close, ema20) and above10 and high_vol and above200

// Phase 3: EMA CROSSBACK — Pullback zur EMA10 ODER EMA20
near10 = math.abs(close - ema10) / ema10 <= 0.02
near20 = math.abs(close - ema20) / ema20 <= 0.02
ema_crossback = above50 and above200 and (near10 or near20) and ema20 > ema50 and rsi >= 35 and rsi <= 72

// Phase 4: BASE N' BREAK — Enge Konsolidierung + Ausbruch mit Volumen
base_high10  = ta.highest(high, 10)
base_low10   = ta.lowest(low, 10)
base_range   = (base_high10 - base_low10) / base_low10
cross_base   = ta.crossover(high, base_high10[1])
base_n_break = base_range < 0.08 and cross_base and bull_trend and high_vol

// Phase 5: EXHAUSTION — 15% über EMA10 + RSI überhitzt
exhaustion = close > ema10 * 1.15 and rsi > rsi_ext_min

// Phase 6: WEDGE DROP — Kurs unter EMA10 UND EMA20 (beide!)
wedge_drop = close < ema10 and close < ema20 and ema20 < ema50

// ══════════════════════════════════════════════════════
// VCP — VOLATILITY CONTRACTION PATTERN (MINERVINI, KORRIGIERT)
// ══════════════════════════════════════════════════════
vcp_vol_dry     = ta.sma(volume, 5) < avg_vol * 0.65   // Volumen trocknet aus während Kontraktion
vcp_contraction = atr5 < atr * atr_ratio and vcp_vol_dry
recent_high     = ta.highest(high, 20)
cross_vcp       = ta.crossover(close, recent_high[1])
vcp_breakout    = vcp_contraction and cross_vcp and bull_trend and high_vol and tt_ok

// ══════════════════════════════════════════════════════
// EINSTIEG & AUSSTIEG
// ══════════════════════════════════════════════════════
// RSI ist kein Pflichtfilter (Kell nutzt RSI nicht primär)
long_signal = (wedge_pop or ema_crossback or base_n_break or vcp_breakout) and not exhaustion

// Stop: 3% unter EMA10 (Kell), maximal 8% Hard Stop (O'Neil)
stop_price   = ema10  * (1 - stop_pct / 100)
hard_stop    = close  * (1 - max_loss  / 100)
// Target: 20% Gewinn (Minervinis erster Take-Profit — statt 2R aus 3%-Stop = ~6%)
target_price = close  * (1 + profit_pct / 100)

// Zeitraum-Filter
in_range = time >= timestamp(from_year, from_month, from_day, 0, 0)

if long_signal and strategy.position_size == 0 and in_range
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit", "Long",
      stop  = math.max(stop_price, hard_stop),
      limit = target_price)

// Trailing-Exit 1: Wedge Drop (Kells echte Ausstiegsregel — EMA10+20 beide unterschritten)
if wedge_drop and strategy.position_size > 0
    strategy.close("Long", comment="Wedge Drop")

// Trailing-Exit 2: Kurs schließt unter EMA50 (Minervini: trailing stop at 50-day EMA)
if strategy.position_size > 0 and close < ema50 and not wedge_drop
    strategy.close("Long", comment="EMA50 Trail")

// Exhaustion-Exit: sofort raus bei Überhitzung
if exhaustion and strategy.position_size > 0
    strategy.close("Long", comment="Exhaustion")

// ══════════════════════════════════════════════════════
// HINTERGRUNDFARBEN
// ══════════════════════════════════════════════════════
bgcolor(show_bg and bull_trend and not exhaustion ? color.new(color.green, 94) : na, title="Aufwaertstrend")
bgcolor(show_bg and wedge_drop                    ? color.new(color.red,   92) : na, title="Abwaertstrend")
bgcolor(show_bg and exhaustion                    ? color.new(color.orange, 90) : na, title="Exhaustion")

// ══════════════════════════════════════════════════════
// SIGNALE PLOTTEN
// ══════════════════════════════════════════════════════
plotshape(wedge_pop, title="Wedge Pop",
  style=shape.triangleup, location=location.belowbar,
  color=#00e676, size=size.small, text="WP")

plotshape(ema_crossback, title="EMA Crossback",
  style=shape.circle, location=location.belowbar,
  color=#00bcd4, size=size.small, text="CB")

plotshape(base_n_break, title="Base n Break",
  style=shape.triangleup, location=location.belowbar,
  color=#2196f3, size=size.normal, text="BnB")

plotshape(vcp_breakout, title="VCP Ausbruch",
  style=shape.diamond, location=location.belowbar,
  color=#9c27b0, size=size.normal, text="VCP")

plotshape(exhaustion and not exhaustion[1], title="Exhaustion",
  style=shape.triangledown, location=location.abovebar,
  color=#ff9800, size=size.small, text="EXT")

plotshape(wedge_drop and not wedge_drop[1], title="Wedge Drop",
  style=shape.triangledown, location=location.abovebar,
  color=#f44336, size=size.normal, text="WD")

// ══════════════════════════════════════════════════════
// INFO-TABELLE
// ══════════════════════════════════════════════════════
var table info_t = table.new(position.top_right, 2, 12,
  bgcolor=color.new(#1a1a2e, 80),
  border_color=color.new(color.gray, 60), border_width=1,
  frame_color=color.new(color.gray, 40),  frame_width=1)

if show_table and barstate.islast
    phase_txt = wedge_drop ? "Wedge Drop" : exhaustion ? "Exhaustion" : vcp_breakout ? "VCP" : base_n_break ? "Base n Break" : ema_crossback ? "EMA CB" : wedge_pop ? "Wedge Pop" : bull_trend ? "Aufwaertstrend" : "Neutral"
    phase_col = (wedge_drop or exhaustion) ? color.orange : (vcp_breakout or base_n_break or ema_crossback or wedge_pop) ? #00e676 : bull_trend ? color.green : color.gray
    bias_txt  = bull_trend and tt_ok ? "LONG" : wedge_drop ? "MEIDEN" : bull_trend ? "LONG (kein TT)" : "NEUTRAL"
    bias_col  = bull_trend and tt_ok ? #00e676 : wedge_drop ? color.red : bull_trend ? color.yellow : color.gray
    tt_txt    = trend_template ? "OK" : "Fehlt"
    tt_col    = trend_template ? #00e676 : color.red
    dist52h   = math.round((1 - close / high52w) * 100, 1)
    in_pos    = strategy.position_size > 0
    pnl_pct   = in_pos ? (close - strategy.position_avg_price) / strategy.position_avg_price * 100 : 0.0

    table.cell(info_t, 0, 0,  "PHASE",      text_color=#888888, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 1, 0,  phase_txt,    text_color=phase_col, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 0, 1,  "EMA 10",     text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 1,  str.tostring(math.round(ema10, 2)), text_color=above10 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 2,  "EMA 20",     text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 2,  str.tostring(math.round(ema20, 2)), text_color=above20 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 3,  "EMA 50",     text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 3,  str.tostring(math.round(ema50, 2)), text_color=above50 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 4,  "EMA 200",    text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 4,  str.tostring(math.round(ema200, 2)), text_color=above200 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 5,  "RSI",        text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 5,  str.tostring(math.round(rsi, 1)), text_color=rsi < rsi_ext_min ? #00e676 : color.orange, text_size=size.small)
    table.cell(info_t, 0, 6,  "VOLUMEN",    text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 6,  high_vol ? "Hoch ✓" : "Normal", text_color=high_vol ? #00e676 : #888888, text_size=size.small)
    table.cell(info_t, 0, 7,  "VCP",        text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 7,  vcp_contraction ? "Kontr. ✓" : "-", text_color=vcp_contraction ? #00e676 : #888888, text_size=size.small)
    table.cell(info_t, 0, 8,  "TREND TMPL", text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 8,  use_tt ? tt_txt : "Aus", text_color=use_tt ? tt_col : #888888, text_size=size.small)
    table.cell(info_t, 0, 9,  "52W Hoch",   text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 9,  str.tostring(dist52h) + "% drunter", text_color=within25_high ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 10, "POSITION",   text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 10, in_pos ? str.tostring(math.round(pnl_pct, 2)) + "%" : "-", text_color=in_pos ? (pnl_pct >= 0 ? #00e676 : color.red) : #888888, text_size=size.small)
    table.cell(info_t, 0, 11, "BIAS",        text_color=#888888, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 1, 11, bias_txt,      text_color=bias_col, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
