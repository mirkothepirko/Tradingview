//@version=6
strategy("Kell + Minervini VCP Strategy [Backtest]",
  overlay=true,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=10,
  initial_capital=10000,
  commission_type=strategy.commission.percent,
  commission_value=0.1,
  slippage=2,
  max_bars_back=500)

// ══════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════
grp_ma   = "Moving Averages"
grp_flt  = "Filter"
grp_vcp  = "VCP Detection"
grp_risk = "Risk Management"
grp_disp = "Display"

ema20_len  = input.int(20,  "EMA 20",  group=grp_ma)
ema50_len  = input.int(50,  "EMA 50",  group=grp_ma)
ema100_len = input.int(100, "EMA 100", group=grp_ma)
ema200_len = input.int(200, "EMA 200", group=grp_ma)

rsi_len  = input.int(14, "RSI Length",        group=grp_flt)
rsi_min  = input.int(45, "RSI Min fuer Long", group=grp_flt)
rsi_max  = input.int(75, "RSI Max fuer Long", group=grp_flt)

vol_len   = input.int(20,    "Volumen Durchschnitt (Bars)",    group=grp_vcp)
vol_mult  = input.float(1.5, "Volumen Multiplikator Ausbruch", step=0.1, group=grp_vcp)
atr_ratio = input.float(0.7, "ATR Kontraktion Schwelle",       step=0.05, group=grp_vcp)

stop_pct    = input.float(3.0, "Stop Loss % unter EMA 20",     step=0.5, group=grp_risk)
rr_ratio    = input.float(2.0, "Risk/Reward Ratio (Target)",   step=0.5, group=grp_risk)
max_loss    = input.float(8.0, "Max Verlust % (O'Neil Regel)", step=0.5, group=grp_risk)
from_year   = input.int(2022,  "Start Jahr (Zeitraum-Filter)", group=grp_risk)
from_month  = input.int(1,     "Start Monat",                  group=grp_risk)
from_day    = input.int(1,     "Start Tag",                    group=grp_risk)

show_bg    = input.bool(true, "Hintergrundfarben", group=grp_disp)
show_table = input.bool(true, "Info-Tabelle",      group=grp_disp)

// ══════════════════════════════════════════════════════
// MOVING AVERAGES
// ══════════════════════════════════════════════════════
ema20  = ta.ema(close, ema20_len)
ema50  = ta.ema(close, ema50_len)
ema100 = ta.ema(close, ema100_len)
ema200 = ta.ema(close, ema200_len)

p20  = plot(ema20,  "EMA 20",  color=color.new(#00e676, 0), linewidth=1)
p50  = plot(ema50,  "EMA 50",  color=color.new(#2196f3, 0), linewidth=2)
p100 = plot(ema100, "EMA 100", color=color.new(#ff9800, 0), linewidth=1)
p200 = plot(ema200, "EMA 200", color=color.new(#f44336, 0), linewidth=2)

fill(p20, p50, color=ema20 > ema50 ? color.new(color.green, 92) : color.new(color.red, 92), title="EMA 20/50 Fill")

// ══════════════════════════════════════════════════════
// INDIKATOREN
// ══════════════════════════════════════════════════════
rsi                      = ta.rsi(close, rsi_len)
[macd_l, macd_s, macd_h] = ta.macd(close, 12, 26, 9)
atr                      = ta.atr(14)
atr5                     = ta.atr(5)
avg_vol                  = ta.sma(volume, vol_len)

// ══════════════════════════════════════════════════════
// BEDINGUNGEN
// ══════════════════════════════════════════════════════
above20    = close > ema20
above50    = close > ema50
above200   = close > ema200
ema_align  = ema20 > ema50
rsi_ok     = rsi >= rsi_min and rsi <= rsi_max
high_vol   = volume >= avg_vol * vol_mult
macd_bull  = macd_h > 0 or (macd_h > macd_h[1] and macd_h > -0.02)
bull_trend = above20 and above50 and above200 and ema_align

// ══════════════════════════════════════════════════════
// OLIVER KELL ZYKLUSPHASEN
// ══════════════════════════════════════════════════════
wedge_pop     = ta.crossover(close, ema50) and rsi > 50 and high_vol and above200

near20        = close <= ema20 * 1.015 and close >= ema20 * 0.985
ema_crossback = above50 and above200 and near20 and rsi >= 38 and rsi <= 65 and ema_align

base_high10  = ta.highest(high, 10)
base_low10   = ta.lowest(low, 10)
base_range   = (base_high10 - base_low10) / base_low10
cross_base   = ta.crossover(high, base_high10[1])
base_n_break = base_range < 0.08 and cross_base and bull_trend and high_vol

exhaustion = close > ema20 * 1.20 and rsi > 78
wedge_drop = close < ema50 and ema20 < ema50 and rsi < 50

// ══════════════════════════════════════════════════════
// VCP
// ══════════════════════════════════════════════════════
vcp_contraction = atr5 < atr * atr_ratio
recent_high     = ta.highest(high, 20)
cross_vcp       = ta.crossover(close, recent_high[1])
vcp_breakout    = vcp_contraction and cross_vcp and bull_trend and high_vol

// ══════════════════════════════════════════════════════
// EINSTIEG & AUSSTIEG
// ══════════════════════════════════════════════════════
long_signal = (wedge_pop or ema_crossback or base_n_break or vcp_breakout) and rsi_ok and not exhaustion

stop_price   = ema20 * (1 - stop_pct / 100)
hard_stop    = close  * (1 - max_loss  / 100)
target_price = close  + (close - stop_price) * rr_ratio

// Zeitraum-Filter
in_range = time >= timestamp(from_year, from_month, from_day, 0, 0)

// Nur einsteigen wenn nicht schon in Position und im gewählten Zeitraum
if long_signal and strategy.position_size == 0 and in_range
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit", "Long",
      stop=math.max(stop_price, hard_stop),
      limit=target_price)

// Ausstieg bei Trendumkehr
exit_signal = (wedge_drop or exhaustion) and strategy.position_size > 0
if exit_signal
    strategy.close("Long", comment="Trend Exit")

// Trailing Stop: wenn Kurs unter EMA 50 schließt (statt EMA 20 — weniger aggressiv)
if strategy.position_size > 0 and close < ema50 and not long_signal
    strategy.close("Long", comment="EMA50 Exit")

// ══════════════════════════════════════════════════════
// HINTERGRUNDFARBEN
// ══════════════════════════════════════════════════════
bgcolor(show_bg and bull_trend and not exhaustion ? color.new(color.green, 94) : na, title="Aufwaertstrend")
bgcolor(show_bg and wedge_drop                    ? color.new(color.red,   92) : na, title="Abwaertstrend")
bgcolor(show_bg and exhaustion                    ? color.new(color.orange, 90) : na, title="Exhaustion")

// ══════════════════════════════════════════════════════
// SIGNALE PLOTTEN
// ══════════════════════════════════════════════════════
plotshape(wedge_pop, title="Wedge Pop",
  style=shape.triangleup, location=location.belowbar,
  color=#00e676, size=size.small, text="WP")

plotshape(ema_crossback and rsi_ok, title="EMA Crossback",
  style=shape.circle, location=location.belowbar,
  color=#00bcd4, size=size.small, text="CB")

plotshape(base_n_break, title="Base n Break",
  style=shape.triangleup, location=location.belowbar,
  color=#2196f3, size=size.normal, text="BnB")

plotshape(vcp_breakout, title="VCP Ausbruch",
  style=shape.diamond, location=location.belowbar,
  color=#9c27b0, size=size.normal, text="VCP")

plotshape(exhaustion and not exhaustion[1], title="Exhaustion",
  style=shape.triangledown, location=location.abovebar,
  color=#ff9800, size=size.small, text="EXT")

plotshape(wedge_drop and not wedge_drop[1], title="Wedge Drop",
  style=shape.triangledown, location=location.abovebar,
  color=#f44336, size=size.normal, text="WD")

// ══════════════════════════════════════════════════════
// INFO-TABELLE
// ══════════════════════════════════════════════════════
var table info_t = table.new(position.top_right, 2, 10,
  bgcolor=color.new(#1a1a2e, 80),
  border_color=color.new(color.gray, 60), border_width=1,
  frame_color=color.new(color.gray, 40),  frame_width=1)

if show_table and barstate.islast
    phase_txt = wedge_drop ? "Wedge Drop" : exhaustion ? "Exhaustion" : vcp_breakout ? "VCP Ausbruch" : base_n_break ? "Base n Break" : ema_crossback ? "EMA Crossback" : wedge_pop ? "Wedge Pop" : bull_trend ? "Aufwaertstrend" : "Neutral"
    phase_col = (wedge_drop or exhaustion) ? color.orange : (vcp_breakout or base_n_break or ema_crossback or wedge_pop) ? #00e676 : bull_trend ? color.green : color.gray
    bias_txt  = bull_trend ? "LONG" : wedge_drop ? "MEIDEN" : "NEUTRAL"
    bias_col  = bull_trend ? #00e676 : wedge_drop ? color.red : color.gray
    in_pos    = strategy.position_size > 0
    pnl_pct   = in_pos ? (close - strategy.position_avg_price) / strategy.position_avg_price * 100 : 0.0

    table.cell(info_t, 0, 0, "PHASE",    text_color=#888888, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 1, 0, phase_txt,  text_color=phase_col, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 0, 1, "EMA 20",   text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 1, str.tostring(math.round(ema20, 3)), text_color=above20 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 2, "EMA 50",   text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 2, str.tostring(math.round(ema50, 3)), text_color=above50 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 3, "EMA 200",  text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 3, str.tostring(math.round(ema200, 3)), text_color=above200 ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 4, "RSI",      text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 4, str.tostring(math.round(rsi, 1)), text_color=rsi_ok ? #00e676 : rsi > rsi_max ? color.orange : color.red, text_size=size.small)
    table.cell(info_t, 0, 5, "MACD",     text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 5, macd_bull ? "Bullisch" : "Bearisch", text_color=macd_bull ? #00e676 : color.red, text_size=size.small)
    table.cell(info_t, 0, 6, "VOLUMEN",  text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 6, high_vol ? "Hoch" : "Normal", text_color=high_vol ? #00e676 : #888888, text_size=size.small)
    table.cell(info_t, 0, 7, "VCP",      text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 7, vcp_contraction ? "Kontraktion" : "-", text_color=vcp_contraction ? #00e676 : #888888, text_size=size.small)
    table.cell(info_t, 0, 8, "POSITION", text_color=#888888, text_size=size.small)
    table.cell(info_t, 1, 8, in_pos ? str.tostring(math.round(pnl_pct, 2)) + "%" : "-", text_color=in_pos ? (pnl_pct >= 0 ? #00e676 : color.red) : #888888, text_size=size.small)
    table.cell(info_t, 0, 9, "BIAS",     text_color=#888888, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
    table.cell(info_t, 1, 9, bias_txt,   text_color=bias_col, text_size=size.small, bgcolor=color.new(#1a1a2e, 70))
