# Kopiere diese Datei zu ".env" und fülle die Werte aus.  .env wird NIE committet (gitignored).

# --- Telegram (Morning-Briefing-Versand via scripts/morning_scan.sh) ---
# 1. In Telegram @BotFather öffnen -> /newbot -> Namen vergeben -> Token kopieren.
# 2. Deine Chat-ID holen: schreibe deinem Bot eine Nachricht, dann @userinfobot fragen,
#    oder https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen und "chat":{"id":...} ablesen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
